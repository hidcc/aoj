
#include <stdio.h>
#include <ctype.h>
#include <stdlib.h>
#include <string.h>
#define PI 3.141592653589793
#include <math.h>
#include <time.h>
#define ll long long int
#include <stdbool.h>
#define MAX 100005
#define NIL -1

typedef struct {
    ll p,l,r;
} Node;
Node T[MAX];
ll n,D[MAX];
void print(ll u){
    ll i,c;
    printf("node %lld: ",u);
    printf("parent = %lld, ",T[u].p);
    printf("depth = %lld, ",D[u]);
    if(T[u].p==NIL)printf("root, ");
    else if(T[u].l==NIL)printf("leaf, ");
    else printf("internal node, ");
    printf("[");
    for(i=0,c=T[u].l;c!=NIL;i++,c=T[c].r){
        if(i)printf(", ");
        printf("%lld",c);
    }
    printf("]\n");
}
int rec(int u,int p){
    D[u]=p;
    if(T[u].r!=NIL)rec(T[u].r,p);
    if(T[u].l!=NIL)rec(T[u].l,p+1);
}
int main(){
    ll i,v,l,j,r,root,d,c;
    scanf("%lld",&n);
    for(i = 0;i<n;i++){
        T[i].p=T[i].l=T[i].r=NIL;
    }
    for(i=0;i<n;i++){
        scanf("%lld %lld",&v,&d);
        for(j=0;j<d;j++){
            scanf("%lld",&c);
            if(j==0)T[v].l=c;
            else T[l].r=c;
            l=c;
            T[c].p=v;
        }
    }
    for(i=0;i<n;i++){
        if(T[i].p==NIL)r=i;
    }
    rec(r,0);
    for(i=0;i<n;i++)print(i);

    return 0;
}