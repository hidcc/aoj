void bubbleSort(Card A[],ll N){
    for(ll i=0;i<N;i++){
        for(ll j=N-1;j>=i+1;j--){
            if(A[j].value<A[j-1].value){
                Card t=A[j];
                A[j]=A[j-1];
                A[j-1]=t;
            }
        }
    }
}
void selectionSort(Card A[],ll N){
    ll minj,i,j;
    for(i=0;i<N;i++){
        minj = i;
        for(j=i;j<N;j++){
            if(A[j].value<A[minj].value)
                minj=j;
        }
        Card t=A[i];
        A[i]=A[minj];
        A[minj]=t;
    }
}

void print(Card A[], ll N){
    for(ll i = 0; i < N; i++){
        if(i > 0) printf(" ");
        printf("%c%c", A[i].suit, A[i].value);
    }
    printf("\n");
}

bool isStable(Card C1[],Card C2[],ll N){
    for(ll i=0;i<N;i++){
        if(C1[i].suit!=C2[i].suit) return false;
    }
    return true;
}
