    for(i=0;i<N;i++){
        scanf(" %c %c",&C1[i].suit,&C1[i].value);
    }
    for(i=0;i<N;i++){
        C2[i]=C1[i];
    }
    bubbleSort(C1,N);
    selectionSort(C2,N);

