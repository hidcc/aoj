typedef struct{
    char suit;
    char value;
}Card;
void print(Card A[],ll N);
void bubbleSort(Card A[],ll N);
void selectionSort(Card A[],ll N);
bool isStable(Card C1[],Card C2[],ll N);
int main(){
    ll i,j,x,N,minj;
    Card C1[100],C2[100];
    scanf("%lld",&N);
    char ch;
