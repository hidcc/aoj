#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define ll long long int

ll n;
ll parent(ll i){return i/2;}
ll left(ll i){return i*2;}
ll right(ll i){return i*2+1;}
int main(){
    ll i,j;
    scanf("%lld",&n);
    ll A[n+1];
    for(i=1;i<=n;i++){
        scanf("%lld",&A[i]);
    }
    for(i=1;i<=n;i++){
        printf("node %lld: key = %lld, ",i,A[i]);
        if (parent(i)>=1)printf("parent key = %lld, ",A[parent(i)]);
        if (left(i)<=n) printf("left key = %lld, ",A[left(i)]);
        if (right(i)<=n) printf("right key = %lld, ",A[right(i)]);
        printf("\n");
    }
    return 0;
}