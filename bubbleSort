
#include <stdio.h>
#include <ctype.h>
#include <stdlib.h>
#include <string.h>
#define PI 3.141592653589793
#include <math.h>
#include <time.h>
#define ll long long int
#include <stdbool.h>
ll bubbleSort(ll *A,ll N);
int main(){
    ll N,i,j;
    scanf("%lld",&N);
    ll A[N];
    for(i=0;i<N;i++){
        scanf("%lld",&A[i]);
    }
    ll count =bubbleSort(A,N);
    for(i=0;i<N;i++){
        if(i!=0) printf(" ");
        printf("%lld",A[i]);
    }
    printf("\n");
    printf("%lld\n",count);

    return 0;
}
ll bubbleSort(ll *A,ll N){
    ll flag =1;
    ll count =0;
    while(flag){
        flag = 0;
        for(ll j=N-1;j>=1;j--){
            if(A[j]<A[j-1]){
                ll tmp = A[j];
                A[j] = A[j-1];
                A[j-1] = tmp;
                flag = 1;
                count ++;
            }
        }
    }
    return count;
}
