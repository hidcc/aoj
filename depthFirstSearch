#include <stdio.h>
#include <string.h>
#define ll long long int
#define N 100
#define INFTY (1<<21)
#define white 0
#define gray 1
#define black 2
ll color[N],d[N],f[N],n;
ll tt;
ll M[N][N];
void dfs();
void dfs_visit(ll u);
int main(){
    ll i,j,v,k,u;
    scanf("%lld",&n);
    for(i=0;i<n;i++){
        for(j=0;j<n;j++){
            M[i][j]=0;
        }
    }
    for(i=0;i<n;i++){
      scanf("%lld %lld",&u,&k);
        u--;
        for(j=0;j<k;j++){
            scanf("%lld",&v);
            v--;
            M[u][v]=1;
        }
    }
    dfs();
    return 0;
}

void dfs(){
    ll u;
    tt=0;
    for(u=0;u<n;u++) color[u]=white;
    for(u=0;u<n;u++){
        if(color[u]==white) dfs_visit(u);
    }
    for(ll i=0;i<n;i++) printf("%lld %lld %lld\n",i+1,d[i],f[i]);
}
void dfs_visit(ll u){
    ll v,k;
    color[u]=gray;
    tt++;
    d[u]= tt;
    for(v=0;v<n;v++){
        if(M[u][v]==0) continue;
        if(color[v]==white) dfs_visit(v);
    }
    color[u]=black;
    f[u]=++tt;
}