ll selectionSort(ll *A,ll N){
    ll count =0;
    for(ll i=0;i<N;i++){
        ll minj =i;
        for(ll j=i;j<N;j++){
            if(A[j]<A[minj])
                minj = j;
        }
        if(minj!=i){
             ll tmp = A[i];
            A[i] = A[minj];
            A[minj] = tmp;
            count++;
        }
    }
    return count;
}
