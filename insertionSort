
#include <stdio.h>
#include <ctype.h>
#include <stdlib.h>
#include <string.h>
#define PI 3.141592653589793
#include <math.h>
#include <time.h>
#define ll long long int
#include <stdbool.h>
void print(ll A[],ll N);

void insertionSort(ll A[],ll N);

int main(){
    ll N,i,j,k,v;
    scanf("%lld",&N);
    ll A[N];
    for(i=0;i<N;i++){
        scanf("%lld",&A[i]);
    }
    print(A,N);
    insertionSort(A,N);
    return 0;
}
void print(ll A[],ll N){
    ll i;
    for(i=0;i<N;i++){
        if(i>0)printf(" ");
        printf("%lld",A[i]);
    }
    printf("\n");
}
void insertionSort(ll A[],ll N){
    ll i,j,k,v;
    for(i=1;i<N;i++){
        v=A[i];
        j=i-1;
        while(j>=0&&A[j]>v){
            A[j+1]=A[j];
            j--;
        }
        A[j+1]=v;
        print(A,N);
    }
}
