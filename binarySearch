ll binarySearch(ll S[],ll n,ll key);

int main(){
    ll c,n,i,j,key;
    scanf("%lld",&n);
    ll S[n+1];
    ll count =0;
    for(i=0;i<n;i++){
        scanf("%lld",&S[i]);
    }
    scanf("%lld",&c);
    for(i=0;i<c;i++){
        scanf("%lld",&key);
        count += binarySearch(S,n,key);
    }
    printf("%lld\n",count);

    return 0;
}

ll binarySearch(ll S[],ll n,ll key){
    ll mid,right,left;
    left = 0;
    right = n;
    while(left<right){
        mid = (left+right)/2;
        if(S[mid]==key){
            return 1;
        }else if(S[mid]>key){
            right=mid;
        }else{
            left=mid+1;
        }
    }
    return 0;
}