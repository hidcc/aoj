#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define ll long long int
#define MAX 10000
#define NIL -1
typedef struct{
    ll parent,left,right;
}Node;

Node T[MAX];
ll n,D[MAX],H[MAX];

void setDepth(ll u,ll d){
    if(u==NIL)return;
    D[u]=d;
    setDepth(T[u].left,d+1);
    setDepth(T[u].right,d+1);
}
ll setHeight(ll u){
    ll h1=0,h2=0;
    if(T[u].left!=NIL)
        h1=setHeight(T[u].left)+1;
    if(T[u].right!=NIL)
        h2=setHeight(T[u].right)+1;
    return H[u]=(h1>h2?h1:h2);
}
ll getSibling(ll u){
    if(T[u].parent==NIL) return NIL;
    if(T[T[u].parent].left!=u&&T[T[u].parent].left!=NIL)
        return T[T[u].parent].left;
    if(T[T[u].parent].right!=u&&T[T[u].parent].right!=NIL)
        return T[T[u].parent].right;
    return NIL;
}
void print(ll u){
    printf("node %lld:",u);
    printf(" parent = %lld,",T[u].parent);
    printf(" sibling = %lld,",getSibling(u));
    ll deg = 0;
    if(T[u].left!=NIL)deg++;
    if(T[u].right!=NIL)deg++;
    printf(" degree = %lld,",deg);
    printf(" depth = %lld,",D[u]);
    printf(" height = %lld,",H[u]);
    if(T[u].parent==NIL){
        printf(" root\n");
    }else if(T[u].left==NIL&&T[u].right == NIL){
        printf(" leaf\n");
    }else{
        printf(" internal node\n");
    }
}

int main(){
    ll i,v,l,r,root=0;
    scanf("%lld",&n);
    for(i=0;i<n;i++)T[i].parent=NIL;
    for(i=0;i<n;i++){
        scanf("%lld %lld %lld",&v,&l,&r);
        T[v].left=l;
        T[v].right=r;
        if(l!=NIL)T[l].parent=v;
        if(r!=NIL)T[r].parent=v;
    }
    for(i=0;i<n;i++)if(T[i].parent==NIL)root=i;
    setDepth(root,0);
    setHeight(root);
    for(i=0;i<n;i++)print(i);
    return 0;
}