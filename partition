#include <stdbool.h>
#define MAX 100000
#define SENTINEL 2000000000
int A[MAX],n;
int partition(int p,int r);

int main(){
    int i;
    scanf("%d",&n);
    for(i=0;i<n;i++){
        scanf("%d",&A[i]);
    }
    int q=partition(0,n-1);
    for(i=0;i<n;i++){
        if(i) printf(" ");
        if(i==q) printf("[");
        printf("%d",A[i]);
        if(i==q) printf("]");
    }
    printf("\n");
    return 0;
}

int partition(int p,int r){
    int i,j,tmp;
    int x=A[r];
    i=p-1;
    for(j=p;j<r;j++){
        if(A[j]<=x){
            i++;
            tmp =A[i],A[i]=A[j],A[j]=tmp;
        }
    }
    tmp = A[i+1],A[i+1]=A[r],A[r]=tmp;
    return i+1;
}