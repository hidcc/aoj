#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define ll long long int
#define MAX 10000
#define NIL -1
typedef struct{
    ll p,l,r;
}Node;

Node T[MAX];
ll n,D[MAX],H[MAX];

void preParse(ll u){
    if(u==NIL)return;
    printf(" %lld",u);
    preParse(T[u].l);
    preParse(T[u].r);
}
void inParse(ll u){
    if(u==NIL)return;
    inParse(T[u].l);
    printf(" %lld",u);
    inParse(T[u].r);
}
void postParse(ll u){
    if(u==NIL)return;
    postParse(T[u].l);
    postParse(T[u].r);
    printf(" %lld",u);
}
int main(){
    ll i,v,l,r,root=0;
    scanf("%lld",&n);
    for(i=0;i<n;i++)T[i].p=NIL;
    for(i=0;i<n;i++){
        scanf("%lld %lld %lld",&v,&l,&r);
        T[v].l=l;
        T[v].r=r;
        if(l!=NIL)T[l].p=v;
        if(r!=NIL)T[r].p=v;
    }
    for(i=0;i<n;i++)if(T[i].p==NIL)root=i;
    printf("Preorder\n");
    preParse(root);
    printf("\n");
    printf("Inorder\n");
    inParse(root);
    printf("\n");
    printf("Postorder\n");
    postParse(root);
    printf("\n");
    return 0;
}